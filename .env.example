NODE_ENV=development
APP_NAME=Restaurent SaaS

# --- URLs / origins -------------------------------------------------------
# Server-side only. WEB_URL is used for Stripe/billing return links and SSR
# fallbacks; API_URL is the target the Next.js proxy forwards /api/v1 and
# /socket.io to. REALTIME_URL mirrors API_URL (Socket.IO runs in-process on the
# API port — there is no separate realtime port).
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
REALTIME_URL=http://localhost:4000

# Browser-inlined (NEXT_PUBLIC_*). Leave BLANK for same-origin deploys so the
# browser calls relative /api/v1 + /socket.io and rides the Next proxy — nothing
# about the host/IP is baked into the bundle, so an IP/DNS change never breaks
# the app. Set these ONLY when the API/customer app is served from a different
# origin than the web app (split-domain prod), e.g. https://api.example.com
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_REALTIME_URL=
# NEXT_PUBLIC_CUSTOMER_ORIGIN=

# --- Ports ---------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000

# --- Data stores ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=restaurent_saas
# Optional: test suites use this instead of MONGODB_URI when provided.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
# Optional: only needed if a Redis-backed socket.io adapter is enabled for
# multi-node realtime. Single-node deploys do not require it.
# REDIS_URL=

# --- Auth (JWT) ----------------------------------------------------------
# Use strong random values (rejected at boot if left as these placeholders),
# e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_GUEST_SECRET=replace-me-guest
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_GUEST_TTL=6h

# --- Media (Cloudinary) --------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restaurent

# --- Billing (Stripe) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Accepts a Stripe Price ID (price_...) or Product ID (prod_...); Product IDs use the active recurring monthly price.
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# --- CORS ----------------------------------------------------------------
# Real browser origins only. Add the production web domain here when deploying.
CORS_ORIGINS=http://localhost:3000

# --- Misc ----------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200
SEED_SUPER_ADMIN_EMAIL=superadmin@servora.test
SEED_SUPER_ADMIN_PASSWORD=SuperAdminPass123!
SEED_ADMIN_EMAIL=platform@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# SENTRY_DSN intentionally omitted — no @sentry/* integration is wired yet.
LOG_LEVEL=debug
